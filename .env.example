# ==============================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN MEDQUIZ AI (Tao-Trac-Nghiem AI)
# Hướng dẫn: Sao chép tệp này thành .env và điền các giá trị thực tế
# Lệnh: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH SERVER & ỨNG DỤNG
# ------------------------------------------------------------------------------
# Môi trường chạy: 'development' | 'production' | 'test'
# Chạy cục bộ (npm run dev / Electron) để 'development'.
# Chỉ đặt 'production' khi chạy trong Docker hoặc bản đóng gói.
NODE_ENV=development

# Cổng lắng nghe của máy chủ HTTP Fastify
PORT=3000

# Địa chỉ lắng nghe. 127.0.0.1 = chỉ máy cục bộ (mặc định, an toàn).
# 0.0.0.0 = mở ra mạng ngoài, dùng trong Docker/Container: khi đó BẮT BUỘC có APP_AUTH_TOKEN.
HOST=127.0.0.1

# Kích thước file tối đa cho phép tải lên (tính bằng Megabytes, tối đa 1000)
MAX_FILE_SIZE_MB=500

# Token bắt buộc cho mọi route /api/* (header `x-app-token`), tối thiểu 32 ký tự.
# - Electron: tự sinh ngẫu nhiên mỗi lần chạy, không cần điền.
# - Docker/web: BẮT BUỘC điền, sinh bằng: openssl rand -hex 32
# Để trống chỉ an toàn khi HOST là loopback (127.0.0.1).
APP_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 2. KHÓA KẾT NỐI GOOGLE GEMINI AI (TUỲ CHỌN - có thể cấu hình trong tab Cài đặt)
# ------------------------------------------------------------------------------
# Đây là phương án dự phòng khi CHƯA cấu hình nhà cung cấp AI nào trong tab Cài đặt
# của ứng dụng. Nếu bạn sẽ thêm Gemini/OpenAI/Anthropic/Local AI qua giao diện thì
# có thể để trống 2 dòng dưới.
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model Gemini sử dụng khi dùng khoá .env ở trên (Google định kỳ ngừng hỗ trợ model cũ)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. CƠ SỞ DỮ LIỆU
# ------------------------------------------------------------------------------
# 'embedded' = PGlite nhúng, không cần cài PostgreSQL (mặc định cho Desktop)
# 'postgres' = dùng DATABASE_URL bên dưới (dùng cho Docker)
DB_MODE=embedded

# Thư mục lưu dữ liệu PGlite (khi DB_MODE=embedded) VÀ settings.json (cấu hình
# nhà cung cấp AI + khoá API, xem src/modules/settings/settings.store.ts).
# Thư mục này cần tồn tại và ghi được dù DB_MODE là gì.
DB_DATA_DIR=data


# Tên Database
POSTGRES_DB=tao_trac_nghiem

# Tên người dùng quản trị PostgreSQL
POSTGRES_USER=postgres

# Mật khẩu người dùng quản trị PostgreSQL
POSTGRES_PASSWORD=postgres_secure_password_123

# Cổng ánh xạ ra máy chủ Host (mặc định 5432)
POSTGRES_PORT=5432

# Chuỗi kết nối Database URL, chỉ dùng khi DB_MODE=postgres
# - Docker Compose: postgres://postgres:postgres_secure_password_123@postgres:5432/tao_trac_nghiem
# - Cài cục bộ:     postgres://postgres:postgres_secure_password_123@localhost:5432/tao_trac_nghiem
DATABASE_URL=postgres://postgres:postgres_secure_password_123@localhost:5432/tao_trac_nghiem

# ------------------------------------------------------------------------------
# 4. BỘ NHỚ ĐỆM & HÀNG ĐỢI TÁC VỤ (REDIS)
# ------------------------------------------------------------------------------
# Địa chỉ máy chủ Redis (trong docker-compose là 'redis', chạy cục bộ là 'localhost')
REDIS_HOST=localhost

# Cổng kết nối Redis
REDIS_PORT=6379

# Mật khẩu Redis (để trống nếu không yêu cầu mật khẩu ở môi trường dev)
REDIS_PASSWORD=

